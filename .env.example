# Copie este arquivo para .env e ajuste os valores.
# O .env NÃO deve ser versionado (já está no .gitignore e no .dockerignore).

# Gere uma chave única por ambiente:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Com DEBUG=False, a aplicação se recusa a iniciar se esta chave não for trocada.
SECRET_KEY=trocar-por-uma-chave-forte

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=agendamento_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Redirecionamento forçado para HTTPS. Padrão: ativo quando DEBUG=False.
# Só mantenha ativo se houver terminação TLS (proxy reverso) na frente da aplicação;
# caso contrário o navegador entra em laço de redirecionamento.
# SECURE_SSL_REDIRECT=False

# --- E-mail via Gmail (SMTP) ---
# Use uma "Senha de app" (Conta Google > Segurança > Verificação em duas etapas > Senhas de app),
# NUNCA a senha normal da conta. Deixe EMAIL_HOST_USER vazio para só imprimir e-mails no console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Agendamento Lab <seu-email@gmail.com>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# --- Regras de agendamento (opcionais; valores padrão abaixo) ---
# AGENDAMENTO_DURACAO_MINIMA_MIN=30
# AGENDAMENTO_DURACAO_MAXIMA_MIN=120
# AGENDAMENTO_BLOCO_MIN=30
# AGENDAMENTO_ANTECEDENCIA_MAXIMA_DIAS=30
# AGENDAMENTO_MAX_RESERVAS_ATIVAS=5
# Horário de funcionamento (0 e 24 = sem restrição). Ex.: 7 e 22
# AGENDAMENTO_HORA_ABERTURA=0
# AGENDAMENTO_HORA_FECHAMENTO=24
